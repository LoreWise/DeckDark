.utmp/
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
*.log

# Arquivos de backup do Blender
*.blend1
*.blend1.meta

# MemoryCaptures podem ficar muito grandes
**/[Mm]emoryCaptures/

# Gravações podem ficar muito grandes
**/[Rr]ecordings/

# Descomente para ignorar o plugin Asset Store Tools
# **/[Aa]ssets/AssetStoreTools*

# Plugin gerado automaticamente pelo Rider
**/[Aa]ssets/Plugins/Editor/JetBrains*

# Cache do Visual Studio
.vs/

# Cache do Gradle
.gradle/

# Arquivos de solução e projeto gerados automaticamente
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
