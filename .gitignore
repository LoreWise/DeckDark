*.pidb.meta
*.pdb.meta
*.mdb.meta

# Relatórios de crash
sysinfo.txt
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics
crashlytics-build.properties

# Test Runner
InitTestScene*.unity*

# Addressables
**/ServerData/
**/[Aa]ssets/StreamingAssets/aa*
